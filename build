#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
open_app=1
for arg in "$@"; do
  case "$arg" in
    --no-open) open_app=0 ;;
    *) printf 'Usage: build [--no-open]\n' >&2; exit 1 ;;
  esac
done
mkdir -p .local/build
clang -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter -mmacosx-version-min=13.3 \
  -framework Cocoa -framework Metal -framework MetalKit -framework QuartzCore -framework UniformTypeIdentifiers \
  src/main.m src/PlotData.m src/PlotRenderer.m src/PlotView.m -o .local/build/plot
stage="$(mktemp -d "${TMPDIR:-/tmp}/plot-build.XXXXXX")"
trap 'rm -rf "$stage"' EXIT
app="$stage/Plot.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp .local/build/plot "$app/Contents/MacOS/plot"
cp src/plot.metal "$app/Contents/Resources/plot.metal"
cp src/Info.plist "$app/Contents/Info.plist"
cp src/icon.icns "$app/Contents/Resources/icon.icns"
codesign --force --sign - "$app"
codesign --verify --strict "$app"
register=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
pkill -f '^/Applications/(Plot|Plots)\.app/Contents/MacOS/(plot|plots)( |$)' 2>/dev/null || true
for installed in /Applications/Plot.app /Applications/Plots.app; do
  if [[ -d "$installed" ]]; then
    "$register" -u "$installed"
    rm -rf "$installed"
  fi
done
mv "$app" /Applications/Plot.app
"$register" -f /Applications/Plot.app
printf 'Built and installed: /Applications/Plot.app\n'

if [[ "$open_app" == 1 ]]; then
  open /Applications/Plot.app
fi
