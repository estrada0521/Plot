#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p build
clang -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter -framework Foundation \
  native/PlotData.m native/tests/data.m -o build/test-data
build/test-data "$@"
./bin/benchmark-metal --verify
clang -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter -mmacosx-version-min=13.3 \
  -framework Cocoa -framework Metal -framework MetalKit -framework QuartzCore -framework UniformTypeIdentifiers \
  native/tests/app.m native/PlotData.m native/PlotRenderer.m native/PlotView.m -o build/test-app
build/test-app
