{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plots",
  "version": "0.1.0",
  "identifier": "com.okadaharuto.plots",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Plots",
        "width": 360,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["csv", "dat", "txt", "ras"],
        "name": "Data File",
        "description": "Plots で開けるデータファイル",
        "role": "Viewer"
      }
    ]
  }
}
